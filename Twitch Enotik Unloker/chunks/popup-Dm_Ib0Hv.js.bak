  <style>
    #dot { animation: dotWake 2.3s cubic-bezier(.18,.86,.24,1) forwards; }
    #activeBody, #activeFace { animation: activeFade 2.3s ease forwards; }
    #leftEye, #rightEye { animation: openEye 2.3s ease forwards; transform-box: fill-box; transform-origin: center; }
    @keyframes dotWake {
      0%, 12% { transform: translateY(210px); fill: #696969; }
      66%, 100% { transform: translateY(0); fill: #ff005b; }
    }
    @keyframes activeFade {
      0%, 12% { opacity: 0; }
      70%, 100% { opacity: 1; }
    }
    @keyframes openEye {
      0%, 20% { transform: scaleY(.07); fill: #565656; }
      66%, 100% { transform: scaleY(1); fill: #ff005b; }
    }
  </style>

  <circle id="dot" cx="410" cy="55" r="54" fill="#696969" transform="translateY(210)"/>
